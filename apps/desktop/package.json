{
  "name": "@openscript/desktop",
  "version": "0.1.0",
  "description": "OpenScript Desktop - Local-first video editor",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.json && NODE_ENV=development bunx --bun electron dist/main/index.js",
    "dev": "concurrently \"bun run dev:renderer\" \"bun run dev:main\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.json",
    "build": "bun run build:renderer && bun run build:main",
    "start": "electron .",
    "package": "electron-builder"
  },
  "author": "OpenScript Team",
  "license": "MIT",
  "build": {
    "appId": "com.openscript.desktop",
    "productName": "OpenScript",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Video"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "fluent-ffmpeg": "^2.1.3"
  }
}
